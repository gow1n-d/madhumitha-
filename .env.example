# AI Heritage Explorer – Environment Configuration Example
# Copy this file to .env and edit values as needed.
# DO NOT commit real secrets or credentials.

# Scraper behaviour
REQUEST_DELAY=2.0          # seconds between HTTP requests
REQUEST_TIMEOUT=30         # seconds for connect + read
MAX_RETRIES=3
BACKOFF_FACTOR=2.0

# Limits
DEFAULT_PAGE_LIMIT=999     # max pages to crawl (999 = unlimited)
SAMPLE_RECORD_LIMIT=10     # records per adapter in sample mode

# Optional: custom User-Agent string
# USER_AGENT=AIHeritageExplorer-Researcher/1.0 (academic use)

# Proxy (leave blank if not needed – never bypass TLS)
# HTTP_PROXY=
# HTTPS_PROXY=
